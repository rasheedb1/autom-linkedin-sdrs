# ===========================================
# Cadence Automator - Git Ignore
# ===========================================

# Environment files (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
.next/
.vercel/

# Compiled API files (generated by build:api)
api/**/*.js
lib/**/*.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db

# IDE/Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/

# Misc
*.local
.cache/
.temp/
.tmp/

# Turborepo
.turbo/
