# ===========================================
# Cadence Automator - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Supabase Configuration (Required)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Keep this secret!

# ===========================================
# Unipile Configuration (Required for LinkedIn)
# ===========================================
# Get these from: https://dashboard.unipile.com
UNIPILE_API_KEY=your-unipile-api-key
UNIPILE_BASE_URL=https://api28.unipile.com:15873

# ===========================================
# Frontend Environment Variables
# ===========================================
# These are prefixed with VITE_ to be accessible in the frontend

# For local development with separate backend:
# VITE_API_BASE_URL=http://localhost:3001
# For Vercel deployment (same domain): leave empty or don't set
VITE_API_BASE_URL=

# Supabase credentials for frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
