# ===========================================
# Cadence Automator - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server Configuration
PORT=3001
NODE_ENV=development  # development | production

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Keep this secret!

# Unipile Configuration
# Get these from: https://dashboard.unipile.com
UNIPILE_API_KEY=your-unipile-api-key
UNIPILE_BASE_URL=https://api28.unipile.com:15873

# URLs Configuration
# For local development: use ngrok URL or localhost
# For production: use your Railway/backend URL
WEBHOOK_BASE_URL=http://localhost:3001

# Frontend URL (for CORS and redirects)
# For local development: http://localhost:5173
# For production: your Vercel URL
FRONTEND_URL=http://localhost:5173
