{
  "name": "cadence-automator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:api": "vercel dev",
    "build": "npm run build -w apps/web",
    "start": "npm run preview -w apps/web",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.2",
    "@vercel/node": "^5.5.28"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vercel": "^39.0.0"
  }
}
